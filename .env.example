# Mindestens 32 Zeichen, kryptographisch zufällig.
# Lokal generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=change-me-32-chars-min-cryptographic-random

# Postgres-Connection-String.
# Lokal: eigener Postgres oder Neon-Free-Tier (https://neon.tech)
# Vercel-Deployment: über Vercel-Storage-Integration (Neon/Postgres) automatisch gesetzt.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Anthropic API Key — für PDF-Charakterbogen-Import (optional)
# Hole dir einen unter https://console.anthropic.com
# Auf Vercel: Settings → Environment Variables → ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-api03-...

# Vercel Blob Token — für Charakter-Portrait-Upload (auf Vercel automatisch durch Blob-Storage gesetzt)
BLOB_READ_WRITE_TOKEN=

# Pusher Channels — optionale Realtime-Schicht statt teurem Polling.
# Free Tier: 200k Nachrichten/Tag + 100 gleichzeitige Verbindungen (https://pusher.com/channels).
# Wenn leer, fällt die App still auf den 30s-Polling-Fallback zurück (funktioniert weiterhin,
# nur eben langsamer und mit mehr Function-Invocations auf Vercel).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
